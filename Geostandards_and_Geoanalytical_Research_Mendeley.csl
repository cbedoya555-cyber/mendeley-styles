<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-GB">
  <info>
    <title>Geostandards and Geoanalytical Research (custom)</title>
    <title-short>GGR</title-short>
    <id>https://www.zotero.org/styles/geostandards-and-geoanalytical-research-custom-2026</id>
    <link href="https://onlinelibrary.wiley.com/page/journal/1751908x/homepage/forauthors.html" rel="documentation"/>
    <updated>2026-08-24T00:00:00+00:00</updated>
    <rights license="https://creativecommons.org/licenses/by-sa/4.0/">Custom CSL based on the journal's author guidelines.</rights>
  </info>

  <macro name="author-citation">
    <names variable="author">
      <name form="short"
            and="text"
            delimiter=", "
            delimiter-precedes-last="never"
            et-al-min="3"
            et-al-use-first="1"/>
      <et-al font-style="italic"/>
    </names>
  </macro>

  <macro name="author-bibliography">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=". "
            and="text"
            delimiter=", "
            delimiter-precedes-last="never"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-bibliography">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=". "
            and="text"
            delimiter=", "
            delimiter-precedes-last="never"/>
      <label variable="editor" form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <citation disambiguate-add-year-suffix="true" collapse="year">
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=" ">
        <text macro="author-citation"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <bibliography et-al-min="999" et-al-use-first="999">
    <sort>
      <key variable="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">
      <text macro="author-bibliography"/>
      <date variable="issued" prefix=" (" suffix=")">
        <date-part name="year"/>
      </date>

      <choose>
        <if type="article-journal">
          <text variable="title" prefix=" "/>
          <group prefix=". ">
            <text variable="container-title" font-style="italic"/>
            <text variable="volume" prefix=", "/>
            <text variable="page" prefix=", "/>
          </group>
        </if>

        <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia">
          <text variable="title" prefix=" "/>
          <group prefix=". In: ">
            <text macro="editor-bibliography"/>
            <text variable="container-title" prefix=", "/>
            <text variable="publisher" prefix=". "/>
            <text variable="publisher-place" prefix=" ("
                  suffix=")"/>
            <text variable="page" prefix=", "/>
          </group>
        </else-if>

        <else-if type="book report thesis">
          <text variable="title" prefix=" "/>
          <group prefix=". ">
            <text variable="publisher"/>
            <text variable="publisher-place" prefix=" ("
                  suffix=")"/>
            <text variable="number-of-pages" prefix=", "/>
            <text value=" p."/>
          </group>
        </else-if>

        <else>
          <text variable="title" prefix=" "/>
          <group prefix=". ">
            <text variable="container-title" font-style="italic"/>
            <text variable="volume" prefix=", "/>
            <text variable="page" prefix=", "/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>

<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-GB">
  <info>
    <title>Geostandards and Geoanalytical Research (custom)</title>
    <title-short>GGR</title-short>
    <id>https://www.zotero.org/styles/geostandards-and-geoanalytical-research-custom-2026</id>
    <link href="https://onlinelibrary.wiley.com/page/journal/1751908x/homepage/forauthors.html" rel="documentation"/>
    <updated>2026-08-24T00:00:00+00:00</updated>
  </info>

  <citation disambiguate-add-year-suffix="true" collapse="year-suffix" year-suffix-delimiter=",">
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=" ">
        <names variable="author">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"
                et-al-min="3" et-al-use-first="1"/>
          <et-al font-style="italic"/>
        </names>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <bibliography>
    <sort>
      <key variable="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
   <layout>

  <!-- AUTHORS AND YEAR -->
<group display="block">
  <names variable="author" font-weight="bold">
    <name name-as-sort-order="all"
          sort-separator=" "
          initialize-with=". "
          and="text"
          delimiter=", "
          delimiter-precedes-last="never"/>
    <substitute>
      <text variable="title"/>
    </substitute>
  </names>

  <date variable="issued" prefix=" (" suffix=")" font-weight="bold">
    <date-part name="year"/>
  </date>
</group>
  <choose>

    <!-- JOURNAL ARTICLES -->
    <if type="article-journal">
      <text variable="title" suffix=". "/>

      <group font-weight="bold" delimiter=", ">
        <text variable="container-title"/>
        <text variable="volume"/>
      </group>

     <text variable="page" prefix=", " suffix="."/>
    </if>

      <!-- BOOKS AND THESES -->
    <else-if type="book thesis">
      <text variable="title" suffix=". "/>
      <text variable="publisher"/>
      <text variable="publisher-place" prefix=", "/>
    </else-if>

    <!-- REPORTS -->
    <else-if type="report">
      <text variable="title" suffix=". "/>
      <text variable="publisher"/>
      <text variable="number" prefix=", "/>
    </else-if>

    <!-- OTHER TYPES -->
    <else>
      <text variable="title" suffix=". "/>

      <group font-weight="bold" delimiter=", ">
        <text variable="container-title"/>
        <text variable="volume"/>
      </group>

      <text variable="page" prefix=", "/>
    </else>

  </choose>

</layout>
  </bibliography>
</style>
